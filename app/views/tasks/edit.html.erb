<% content_for :title, "Editing task" %>

<div class="container py-4">
  <div class="card shadow-sm">
    <div class="card-header">
      <h1 class="h4 mb-0">タスク編集</h1>
    </div>

    <div class="card-body">
      <%= render "form", task: @task %>
    </div>

    <div class="card-footer d-flex gap-2">
      <%= link_to "一覧へ戻る", tasks_path, class: "btn btn-outline-primary" %>
      <%= link_to "詳細へ戻る", @task, class: "btn btn-outline-secondary" %>
    </div>
  </div>
</div><% content_for :title, "Editing task" %>